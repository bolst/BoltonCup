@page "/log-in-or-sign-up"
@inject AuthSessionStateService AuthSessionState
@inject ISnackbar Snackbar

<AutoEditForm T="LogInOrSignUpFormModel" EditContext="_editContext" OnValidSubmit="OnSubmit" Title="Log in or sign up" />

@code {
    
    private readonly LogInOrSignUpFormModel _model = new();
    private EditContext? _editContext;

    protected override void OnInitialized() 
    {
        _model.Email = AuthSessionState.Context.Email ?? string.Empty;
        _editContext = new EditContext(_model);
    }

    async Task OnSubmit(EditContext _)
    {
        try
        {
            await AuthSessionState.LogInOrSignUpAsync(_model);
        }
        catch (ApiException e) when (e.IsTooManyRequests())
        {
            Snackbar.Add(e.GetTooManyRequestsMessage(), Severity.Warning);
        }
    }

}