@namespace BoltonCup.WebClient.Components.Shared

<MudLink Href="@Href" Underline="Underline.None" Color="Color.Inherit">
    <MudCard Class="mud-height-full d-flex flex-column" Elevation="0" Outlined>
        @if (!string.IsNullOrEmpty(Album.CoverImageUrl))
        {
            <MudCardMedia Image="@Album.CoverImageUrl" Height="240" />
        }
        <MudCardContent Class="flex-grow-1 d-flex flex-column gap-2">
            <MudLink Href="@Href" Underline="Underline.Hover" Color="Color.Inherit">
                <MudText Typo="@Typo.h6"><b>@Album.Title</b></MudText>
            </MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Album.OccurredAt.ToLocalTime().ToString("MMMM d, yyyy")</MudText>
        </MudCardContent>
    </MudCard>
</MudLink>

@code {

    [Parameter]
    [EditorRequired]
    public required Sdk.AlbumDto Album { get; set; }

    string Href => $"/albums/{Album.Slug}";

}