@using System.Globalization
@using BoltonCup.Sdk
@namespace BoltonCup.WebClient.Components.Shared
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="scores-nav">
    <div class="tournament-picker">
        <a class="@ArrowClass(PreviousTournamentHref)" href="@PreviousTournamentHref" aria-label="Previous tournament">
            <MudIcon Icon="@Icons.Material.Rounded.ChevronLeft" Size="Size.Small" />
        </a>
        <div class="tournament-name">
            @if (!string.IsNullOrEmpty(CurrentTournament?.Logo))
            {
                <img src="@CurrentTournament.Logo" alt="" />
            }
            <span>@CurrentTournament?.Name</span>
        </div>
        <a class="@ArrowClass(NextTournamentHref)" href="@NextTournamentHref" aria-label="Next tournament">
            <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" />
        </a>
    </div>
    <div @ref="_stripRef" class="day-strip">
        @foreach (var day in CurrentTournament?.Days ?? [])
        {
            var date = ToDateOnly(day.Date);
            var isSelected = date == SelectedDate;
            <a class="@(isSelected ? "day-tile selected" : "day-tile")" href="@DayHref(date)" data-selected="@(isSelected ? "true" : null)">
                <span class="day-tile-top">
                    <span>@date.ToString("M/d", CultureInfo.InvariantCulture)</span>
                    <span>@date.ToString("ddd", CultureInfo.CurrentCulture).ToUpperInvariant()</span>
                </span>
                <span class="day-tile-count">@GameCountLabel(day.GameCount)</span>
            </a>
        }
    </div>
</div>

@code {

    [Parameter]
    [EditorRequired]
    public required GameScoresDto Scores { get; set; }

    ElementReference _stripRef;
    IJSObjectReference? _module;
    DateOnly? _scrolledDate;
    List<TournamentDays> _tournaments = [];
    int _currentIndex = -1;

    DateOnly SelectedDate => ToDateOnly(Scores.Date);

    TournamentDays? CurrentTournament => _currentIndex >= 0 ? _tournaments[_currentIndex] : null;

    string? PreviousTournamentHref => _currentIndex > 0 ? DayHref(_tournaments[_currentIndex - 1].LastDate) : null;

    string? NextTournamentHref => _currentIndex >= 0 && _currentIndex < _tournaments.Count - 1
        ? DayHref(_tournaments[_currentIndex + 1].FirstDate)
        : null;

    protected override void OnParametersSet()
    {
        _tournaments = Scores.Days
            .GroupBy(d => d.TournamentId)
            .Select(g => new TournamentDays(
                g.Key,
                g.First().TournamentName,
                g.First().TournamentLogo,
                g.OrderBy(d => d.Date).ToList()))
            .OrderBy(t => t.FirstDate)
            .ToList();
        _currentIndex = _tournaments.FindIndex(t => t.Days.Any(d => ToDateOnly(d.Date) == SelectedDate));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrolledDate == SelectedDate)
        {
            return;
        }

        _scrolledDate = SelectedDate;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/Scores/ScoresDateStrip.razor.js?v=1.1");
        await _module.InvokeVoidAsync("scrollSelectedIntoView", _stripRef);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    static string ArrowClass(string? href) => href is null ? "picker-arrow disabled" : "picker-arrow";

    static DateOnly ToDateOnly(DateTimeOffset date) => DateOnly.FromDateTime(date.DateTime);

    static string DayHref(DateOnly date) => $"/scores/{date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    static string GameCountLabel(int count) => count == 1 ? "1 Game" : $"{count} Games";

    record TournamentDays(int Id, string Name, string? Logo, List<GameDayDto> Days)
    {
        public DateOnly FirstDate => ToDateOnly(Days[0].Date);

        public DateOnly LastDate => ToDateOnly(Days[^1].Date);
    }

}