@namespace BoltonCup.WebClient.Components.Shared

<MudCard Class="mud-height-full d-flex flex-column" Elevation="0" Outlined>
    @if (!string.IsNullOrEmpty(Post.CoverImageUrl))
    {
        <MudCardMedia Image="@Post.CoverImageUrl" Height="@(Featured ? 240 : 160)" />
    }
    <MudCardContent Class="flex-grow-1 d-flex flex-column gap-2">
        <MudLink Href="@Href" Underline="Underline.None" Color="Color.Inherit">
            <MudText Typo="@(Featured ? Typo.h5 : Typo.h6)"><b>@Post.Title</b></MudText>
        </MudLink>
        @if (Post.PublishedAt is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Post.PublishedAt.Value.ToLocalTime().ToString("MMMM d, yyyy")</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(Post.Summary))
        {
            <MudText Typo="Typo.body2">@Post.Summary</MudText>
        }
        <NewsTagChips Tags="Post.Tags" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Href="@Href" Variant="Variant.Text" Color="Color.Primary">Read more</MudButton>
    </MudCardActions>
</MudCard>

@code {

    [Parameter, EditorRequired]
    public required Sdk.NewsPostDto Post { get; set; }

    [Parameter]
    public bool Featured { get; set; }

    private string Href => $"/news/{Post.Slug}";

}
