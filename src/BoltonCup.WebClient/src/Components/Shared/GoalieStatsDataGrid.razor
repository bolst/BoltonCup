@namespace BoltonCup.WebClient.Components.Shared

@using BoltonCup.Sdk
@inject IBoltonCupApi BoltonCupApi

@if (_filtersReady)
{
    <MudDataGrid
        @ref="_dataGrid"
        T="Sdk.GoalieStatDto"
        Class="filter-datagrid"
        ServerData="ServerReload"
        Breakpoint="Breakpoint.None"
        RowStyle="height: 50px"
        RowsPerPage="50"
        Elevation="0"
        ShowColumnOptions="false"
        AllowUnsorted
        Striped
        Dense>
        <ToolBarContent>
            <div class="d-flex flex-row align-center gap-3 flex-wrap">
                <FilterToolbarField
                    T="Sdk.TournamentDto?" Label="Tournament"
                    Value="@_filter.Tournament" ValueChanged="OnFilterTournamentChange" OnApplyClicked="ApplyFiltersAsync"
                    ToStringFunc="x => x?.Name">
                    <TournamentFilter/>
                </FilterToolbarField>
                
                <FilterToolbarField
                    T="IReadOnlyCollection<Sdk.TeamDto>?" Label="Team"
                    @bind-Value="@_filter.Teams" OnApplyClicked="@ApplyFiltersAsync"
                    ToStringFunc="@TeamListToStringFunc" Disabled="@(_filter.Tournament?.Id is null)">
                    <TeamsFilter TournamentId="@_filter.Tournament?.Id" />
                </FilterToolbarField>
            </div>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.FullName" Title="Player" Sortable="false" StickyLeft>
                <CellTemplate>
                    <PlayerLink Label="@context.Item.FullName" PlayerId="context.Item.PlayerId" />
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.TeamName" Title="Team" Hidden="@(_filter.Tournament is null)">
                <CellTemplate>
                    <div class="d-flex flex-row align-center justify-space-evenly">
                        <MudText Typo="Typo.body2">@context.Item.TeamAbbreviation</MudText>
                        <MudImage Src="@context.Item.TeamLogoUrl" Height="24" Alt="@context.Item.TeamName"/>
                    </div>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Position" Title="Position"/>
            <PropertyColumn Property="x => x.GamesPlayed" Title="GP" CellStyle="@_dataCellStyle"/>
            <PropertyColumn Property="x => x.GoalsAgainstAverage" Title="GAA" CellStyle="@_dataCellStyle" Format="F2" InitialDirection="SortDirection.Ascending"/>
            <PropertyColumn Property="x => x.Shutouts" Title="SO" CellStyle="@_dataCellStyle" />
            <PropertyColumn Property="x => x.Wins" Title="W" CellStyle="@_dataCellStyle" />
            <PropertyColumn Property="x => x.PenaltyMinutes" Title="PIM" CellStyle="@_dataCellStyle" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Sdk.GoalieStatDto" PageSizeSelector="false"/>
        </PagerContent>
    </MudDataGrid>
}

@code {

    [Parameter]
    public StatsFilterQuery Query { get; set; } = StatsFilterQuery.Empty;

    [Parameter]
    public EventCallback<StatsFilterQuery> QueryChanged { get; set; }

    private MudDataGrid<Sdk.GoalieStatDto> _dataGrid = null!;
    private const string _dataCellStyle = "max-width: 30px";

    private readonly GoalieStatsFilterModel _filter = new();
    StatsFilterQuery? _receivedQuery;
    StatsFilterQuery? _appliedQuery;
    int _resolveGeneration;
    bool _filtersReady;

    StatsFilterQuery CurrentQuery => new StatsFilterQuery(_filter.Tournament?.Id, _filter.Teams?.Select(x => x.Id).ToList() ?? [], Query.Position);

    protected override async Task OnParametersSetAsync()
    {
        // A parent re-render can repeat a stale Query before the new URL arrives; act only on a new value.
        if (_receivedQuery is not null && Query.Matches(_receivedQuery))
        {
            return;
        }

        _receivedQuery = Query;
        // Position belongs to the skater grid; a change to it alone does not affect goalie data.
        if (_appliedQuery is not null && Query.Matches(_appliedQuery with { Position = Query.Position }))
        {
            _appliedQuery = _appliedQuery with { Position = Query.Position };
            return;
        }

        var generation = ++_resolveGeneration;
        var tournament = await BoltonCupApi.FindTournamentAsync(Query.TournamentId);
        var teams = tournament is not null && Query.TeamIds.Count > 0
            ? await BoltonCupApi.FindTeamsAsync(tournament.Id, Query.TeamIds)
            : null;
        if (generation != _resolveGeneration)
        {
            return;
        }

        _filter.Tournament = tournament;
        _filter.Teams = teams;
        _appliedQuery = CurrentQuery;

        if (_filtersReady && _dataGrid is not null)
        {
            await _dataGrid.ReloadServerData();
        }
        _filtersReady = true;

        if (!_appliedQuery.Matches(Query))
        {
            await QueryChanged.InvokeAsync(_appliedQuery);
        }
    }
    

    private async Task<GridData<Sdk.GoalieStatDto>> ServerReload(GridState<Sdk.GoalieStatDto> state, CancellationToken cancellationToken)
    {
        string? sortBy = null;
        bool? descending = null;
        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        if (sortDefinition is not null)
        {
            sortBy = sortDefinition.SortBy;
            descending = sortDefinition.Descending;
        }
        
        var data = await BoltonCupApi.GetGoalieStatsAsync(
            tournamentId: _filter.Tournament?.Id,
            teamIds: _filter.Teams?.Select(x => x.Id).ToList(),
            page: state.Page + 1, 
            size: state.PageSize,
            sortBy: sortBy,
            descending: descending,
            cancellationToken: cancellationToken
        );
        
        return new GridData<Sdk.GoalieStatDto> {
            TotalItems = data.Total,
            Items = data.Items,
        };
    }

    void OnFilterTournamentChange(Sdk.TournamentDto? tournament)
    {
        _filter.Tournament = tournament;
        _filter.Teams = null;
    }

    async Task ApplyFiltersAsync()
    {
        var query = CurrentQuery;
        if (_appliedQuery is not null && query.Matches(_appliedQuery))
        {
            return;
        }

        _resolveGeneration++;
        _appliedQuery = query;
        await QueryChanged.InvokeAsync(query);
        await _dataGrid.ReloadServerData();
    }
    
    private static string? TeamListToStringFunc(IReadOnlyCollection<Sdk.TeamDto>? teams)
    {
        if (teams?.Count is null or 0)
        {
            return null;
        }
        if (teams.Count <= 3)
        {
            return string.Join(", ", teams.Select(x => x.NameShort));
        }

        return $"{teams.First().NameShort} and {teams.Count - 1} more";
    }

    private class GoalieStatsFilterModel
    {
        public Sdk.TournamentDto? Tournament { get; set; }
        public IReadOnlyCollection<Sdk.TeamDto>? Teams { get; set; }
    }

}