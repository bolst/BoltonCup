@using BoltonCup.Sdk
@using MudBlazor.Services
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IBrowserViewportService ViewportService

<div @ref="_root" class="d-flex flex-column gap-3 border-y mud-border-lines-default pa-4">
    <MudText Typo="Typo.h6"><b>Must Watch</b></MudText>
    <MudCarousel @ref="_carousel"
                 TData="object"
                 Style="height: 350px"
                 BulletsColor="Color.Primary"
                 AutoCycle="false"
                 ShowArrows="false"
                 ShowBullets>
        @foreach (var page in Highlights.Chunk(_chunkSize))
        {
            <MudCarouselItem Transition="Transition.Slide" Color="Color.Surface">
                <div class="d-flex gap-3 overflow-x-scroll px-1 mw-overscroll">
                    @foreach (var item in page)
                    {
                        @HighlightCard(item, _cardWidth)
                    }
                </div>
            </MudCarouselItem>
        }
    </MudCarousel>
</div>

@code {

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<RecentHighlightDto> Highlights { get; set; }

    private MudCarousel<object>? _carousel;
    private ElementReference _root;

    private IJSObjectReference? _module;
    private IJSObjectReference? _overscroll;
    private DotNetObjectReference<MustWatchCarousel>? _dotNetRef;

    // How many cards make up one carousel page, and each card's fixed width.
    // Updated reactively as the viewport crosses breakpoints.
    private int _chunkSize = 4;
    private string _cardWidth = "280px";

    private int PageCount => (Highlights.Count + _chunkSize - 1) / _chunkSize;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Sets _chunkSize/_cardWidth for the current breakpoint (fireImmediately)
        // and keeps them in sync as the window is resized/rotated.
        await ViewportService.SubscribeAsync(this, fireImmediately: true);

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Shared/MustWatchCarousel.razor.js?v=1.0.2"
        );
        _dotNetRef = DotNetObjectReference.Create(this);
        _overscroll = await _module.InvokeAsync<IJSObjectReference>("initOverscroll", _root, _dotNetRef);
    }

    /// <summary>
    /// Called from JS when the user over-scrolls past a page edge.
    /// <paramref name="direction"/> is +1 (next) or -1 (previous).
    /// </summary>
    [JSInvokable]
    public Task Advance(int direction)
    {
        if (_carousel is null)
        {
            return Task.CompletedTask;
        }

        var target = _carousel.SelectedIndex + direction;
        if (target < 0 || target >= PageCount)
        {
            return Task.CompletedTask;
        }

        _carousel.MoveTo(target);
        return InvokeAsync(StateHasChanged);
    }

    Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

    ResizeOptions IBrowserViewportObserver.ResizeOptions => new ResizeOptions
    {
        ReportRate = 100,
        NotifyOnBreakpointOnly = true,
    };

    async Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        var (chunk, width) = args.Breakpoint switch
        {
            Breakpoint.Xs => (2, "220px"),
            Breakpoint.Sm => (3, "250px"),
            _ => (4, "280px"),
        };

        if (chunk == _chunkSize)
        {
            return;
        }

        _chunkSize = chunk;
        _cardWidth = width;

        // Re-chunking can shrink the page count; keep the selection in range.
        var pageCount = PageCount;
        if (_carousel is { } carousel && carousel.SelectedIndex >= pageCount)
        {
            carousel.MoveTo(Math.Max(0, pageCount - 1));
        }

        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment HighlightCard(RecentHighlightDto item, string width)
        => @<div style="@($"flex: 0 0 {width}")">
            <VideoHighlight Highlight="@item.Highlight" MaxWidth="100%" />
            <MudText Typo="Typo.caption">@item.GameTime.ToLocalTime().ToString("MMM d, yyyy")</MudText>
        </div>;

    public async ValueTask DisposeAsync()
    {
        await ViewportService.UnsubscribeAsync(this);

        if (_overscroll is not null)
        {
            try
            {
                await _overscroll.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
            }
            await _overscroll.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }
}
