@using BoltonCup.Core
@using GameState = BoltonCup.Sdk.GameState
@namespace BoltonCup.WebClient.Components.Shared

<MudPaper Class="@Classname" Width="100%" Height="100px" Elevation="0" Outlined>
    @TeamTemplate(Game.AwayTeam, reverse: false)
    @TeamGoalText(Game.AwayTeam)
    <div class="d-flex flex-column align-center justify-space-evenly">
        @GetHeaderChip(Game)
        <MudText Typo="Typo.caption">@Game.GameTime.ToString("d")</MudText>
    </div>
    @TeamGoalText(Game.HomeTeam)
    @TeamTemplate(Game.HomeTeam, reverse: true)
</MudPaper>

@code {

    [Parameter, EditorRequired]
    public required Sdk.GameSingleDto Game { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string Classname => $"d-flex flex-row align-center justify-space-evenly gap-3 {Class}";
    
    private Sdk.TeamInGameDto? GetWinningTeam()
    {
        if (Game is not { GameState: GameState.Completed, HomeTeam: not null, AwayTeam: not null })
        {
            return null;
        }
        if (Game.HomeTeam.Goals == Game.AwayTeam.Goals)
        {
            return null;
        }
        return Game.HomeTeam.Goals > Game.AwayTeam.Goals ? Game.HomeTeam : Game.AwayTeam;
    }
    
    private static RenderFragment GetHeaderChip(Sdk.GameSingleDto game)
    {
        var (text, color, icon) = game.GameState switch
        {
            GameState.Completed => ("FINAL", Color.Default, null),
            GameState.InProgress => ("LIVE", Color.Error, Icons.Material.Rounded.Circle),
            _ => (game.GameTime.ToLocalTime().ToString("t"), Color.Default, null),
        };
        return @<MudChip T="string" Variant="Variant.Text" Size="Size.Small" Label="true" Color="@color" Icon="@icon"><b>@text</b></MudChip>;
    }

    private RenderFragment TeamGoalText(Sdk.TeamInGameDto? team)
    {
        if (team is null)
        {
            return @<MudText Typo="Typo.h4">-</MudText>;
        }
        
        return team.Id == GetWinningTeam()?.Id 
            ? @<MudText Typo="Typo.h4"><b>@team.Goals</b></MudText> 
            : @<MudText Typo="Typo.h4">@team.Goals</MudText>;
    }

    private RenderFragment TeamTemplate(Sdk.TeamInGameDto? team, bool reverse)
    {
        var flexDirection = reverse ? "flex-row-reverse" : "flex-row";
        return @<div class="d-flex @flexDirection align-center justify-center flex-wrap gap-1">
                    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert>
                        <MudImage Src="@team?.Logo" Height="72"/>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert>
                        <MudImage Src="@team?.Logo" Height="48" />
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert>
                        <MudText Align="Align.Center"><b>@team?.Name</b></MudText>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert>
                        <MudFlexBreak />
                        <MudText Align="Align.Center"><b>@team?.Abbreviation</b></MudText>
                    </MudHidden>
            </div>;
    }

}