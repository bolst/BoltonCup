@using BoltonCup.Admin.Services
@inject TournamentStateService TournamentState
@inject IDialogService DialogService
@implements IDisposable

<MudChip T="string" Variant="Variant.Outlined" OnClick="@OpenDialogAsync">
    <div class="d-flex align-center" style="gap: 8px;">
        @if (_current is not null)
        {
            <BoltonCupImage Src="@_current.Logo" Height="32" ObjectFit="ObjectFit.Contain" />
            <span><b>@_current.Name</b></span>
        }
        else
        {
            <span><b>Select a tournament</b></span>
        }
    </div>
</MudChip>

@code {

    private Tournament? _current;

    protected override void OnInitialized()
    {
        TournamentState.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Storage / URL resolution needs JS interop, which is only available after the first render.
        if (!firstRender)
        {
            return;
        }

        _current = await TournamentState.GetCurrentAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        var dialog = await DialogService.ShowAsync<SelectTournamentDialog>(null, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Tournament tournament })
        {
            await TournamentState.SetCurrentAsync(tournament);
        }
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            _current = await TournamentState.GetCurrentAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TournamentState.Changed -= OnStateChanged;
    }

}
