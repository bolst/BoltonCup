@page "/games/highlights"
@using System.Linq.Expressions
@using BoltonCup.Common

<EntityDataGrid
    T="Highlight"
    NewItemFunc="NewItemFunc"
    Include="@_includes"
    TournamentFilter="TournamentFilter"
    Comparer="_comparer"
    ColumnResizeMode="ResizeMode.None">
    <Columns>
        <PropertyColumn Title="Video ID" Property="x => x.VideoId" CellStyle="max-width: 6rem" Required />
        <PropertyColumn Title="Title" Property="x => x.Title" />
        <PropertyColumn Title="Description" Property="x => x.Description" Required="false" />
    </Columns>
    <ChildRowContent>
        <div class="pa-2">
            <TagInput TTag="HighlightTag" Subject="context.Item" />
        </div>
    </ChildRowContent>
</EntityDataGrid>

@code {

    private static readonly HighlightComparer _comparer = new();

    private async Task<Highlight?> NewItemFunc()
    {
        return new Highlight
        {
        };
    }

    private static readonly Func<IQueryable<Highlight>, IQueryable<Highlight>> _includes =
        x => x
            .Include(h => h.Tags).ThenInclude(t => t.Game).ThenInclude(g => g!.HomeTeam)
            .Include(h => h.Tags).ThenInclude(t => t.Game).ThenInclude(g => g!.AwayTeam)
            .Include(h => h.Tags).ThenInclude(t => t.Game).ThenInclude(g => g!.Tournament)
            .Include(h => h.Tags).ThenInclude(t => t.Player).ThenInclude(p => p!.Account)
            .Include(h => h.Tags).ThenInclude(t => t.Team)
            .Include(h => h.Tags).ThenInclude(t => t.Tournament)
            .Include(h => h.Tags).ThenInclude(t => t.Label);

    // Highlights carrying no tournament-bearing tag belong to no tournament. They must stay
    // visible or a newly saved highlight disappears from the only page that can tag it.
    private static Expression<Func<Highlight, bool>> TournamentFilter(int id) => x => x.Tags.Any(t =>
            t.TournamentId == id
            || (t.Game != null && t.Game.TournamentId == id)
            || (t.Player != null && t.Player.TournamentId == id)
            || (t.Team != null && t.Team.TournamentId == id))
        || !x.Tags.Any(t =>
            t.TournamentId != null
            || t.GameId != null
            || t.PlayerId != null
            || t.TeamId != null);

}
