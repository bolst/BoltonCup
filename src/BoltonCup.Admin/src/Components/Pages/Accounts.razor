@page "/accounts"
@inject IAccountService AccountService

<EntityDataGrid 
    @ref="_dataGrid" 
    T="Account" 
    SearchBy="x => x.FirstName + ' ' + x.LastName"
    Comparer="_comparer"
    OnSave="PrepareForSave">
    <Columns>
        <PropertyColumn Title="Id" Property="x => x.Id" Editable="false"/>
        <PropertyColumn Title="First" Property="x => x.FirstName"/>
        <PropertyColumn Title="Last" Property="x => x.LastName"/>
        <PropertyColumn Title="Email" Property="x => x.Email" Editable="true" />
        <PropertyColumn Title="Phone" Property="x => x.Phone" Required="false" Editable="true" />
        <ImageColumn T="Account" Title="Avatar" Property="x => x.Avatar" OnImageUploaded="UpdateAvatar" />
        <ImageColumn T="Account" Title="Banner" Property="x => x.Banner" OnImageUploaded="UpdateBanner" />
        <DatePickerColumn Title="Born" Property="x => x.Birthday" />
        <PropertyColumn Title="Highest Level" Property="x => x.HighestLevel">
            <EditTemplate>
                <HighestLevelSelect 
                    Value="@context.Item.HighestLevel"
                    ValueChanged="async v => { context.Item.HighestLevel = v; await _dataGrid.NotifyItemChangedAsync(context.Item); }"/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Title="Beer" Property="x => x.PreferredBeer" />
        <PropertyColumn Title="Hometown" Property="x => x.Hometown" Required="false" Editable="true" />
        <PropertyColumn Title="User ID" Property="x => x.UserId" Required="false" Editable="true" />
        <ImageColumn T="Account" Title="Prev. Team Logo" Property="x => x.PreviousTeamLogo" OnImageUploaded="UpdatePreviousTeamLogo" />
    </Columns>
</EntityDataGrid>

@code {

    private EntityDataGrid<Account> _dataGrid = null!;
    private readonly AccountComparer _comparer = new();


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await _dataGrid.ExtendSortAsync("LastName", SortDirection.Ascending, x => x.LastName);
        await _dataGrid.ExtendSortAsync("FirstName", SortDirection.Ascending, x => x.FirstName);
    }

    // A cleared cell saves "", and two of those would collide on the unique user_id index.
    void PrepareForSave(ChangeTracker<Account> changes)
    {
        foreach (var account in changes.NewItems.Concat(changes.EditItems))
        {
            account.UserId = string.IsNullOrWhiteSpace(account.UserId) ? null : account.UserId.Trim();
        }
    }

    private async Task UpdateAvatar(ImageUploadResult<Account> result)
    {
        if (string.IsNullOrEmpty(result.NewKey)) 
            return;
        await AccountService.UpdateAvatarAsync(result.Item.Id, result.NewKey);
    }    
    
    private async Task UpdateBanner(ImageUploadResult<Account> result)
    {
        if (string.IsNullOrEmpty(result.NewKey))
            return;
        await AccountService.UpdateBannerAsync(result.Item.Id, result.NewKey);
    }

    private async Task UpdatePreviousTeamLogo(ImageUploadResult<Account> result)
    {
        if (string.IsNullOrEmpty(result.NewKey))
            return;
        await AccountService.UpdatePreviousTeamLogoAsync(result.Item.Id, result.NewKey);
    }
}