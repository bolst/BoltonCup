@namespace BoltonCup.Timekeeper.Components.Shared
@using BoltonCup.Sdk
@using BoltonCup.Timekeeper.Services.Music
@implements IDisposable
@inject MusicDownloadService Download

<MudDialog>
    <DialogContent>
        @if (Download.IsOffline)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pt-1">
                <MudIcon Icon="@Icons.Material.Rounded.CloudOff" Size="Size.Large" Color="Color.Warning" />
                <MudText Align="Align.Center">Downloading music needs an internet connection.</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Downloaded @(Download.Done) / @Download.Total
                    @if (Download.Skipped > 0) { <text>(@Download.Skipped already cached)</text> }
                </MudText>
                <MudProgressLinear Color="Color.Primary" Value="@Download.OverallPercent" />

                <MudList T="string" Dense Class="overflow-auto" Style="max-height: 280px;">
                    @foreach (var track in Tracks)
                    {
                        var status = Download.Statuses.TryGetValue(track.FileKey, out var s)
                            ? s : MusicDownloadService.ItemStatus.Pending;
                        <MudListItem T="string">
                            <div class="d-flex align-center gap-2">
                                @switch (status)
                                {
                                    case MusicDownloadService.ItemStatus.Done:
                                    case MusicDownloadService.ItemStatus.Skipped:
                                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        break;
                                    case MusicDownloadService.ItemStatus.Downloading:
                                        <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary" />
                                        break;
                                    case MusicDownloadService.ItemStatus.Failed:
                                        <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                                        break;
                                    default:
                                        <MudIcon Icon="@Icons.Material.Rounded.Schedule" Color="Color.Default" Size="Size.Small" />
                                        break;
                                }
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.body2"><b>@track.Title</b></MudText>
                                    <MudText Typo="Typo.caption">@track.Artist</MudText>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>

                @if (Download.StorageText is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Download.StorageText</MudText>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (Download.IsRunning)
        {
            <MudButton OnClick="Cancel" Color="Color.Error">Cancel download</MudButton>
        }
        else if (Download.Failed > 0)
        {
            <MudButton OnClick="RetryFailed" Color="Color.Primary">Retry failed</MudButton>
        }
        <MudButton OnClick="Close">@(Download.IsRunning ? "Continue in background" : "Done")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public IReadOnlyList<PlaylistTrackDto> Tracks { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Download.OnProgressChanged += OnProgress;

        await Dialog.SetOptionsAsync(Dialog.Options with
        {
            CloseOnEscapeKey = true,
            BackdropClick = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        });

        // Kick off a run only if one isn't already going — reopening mid-download shows live progress.
        if (!Download.IsRunning)
        {
            Download.Start(Tracks);
        }
    }

    private void Cancel() => Download.Cancel();

    private void RetryFailed() => Download.Retry();

    private void Close() => Dialog.Close();

    private void OnProgress() => InvokeAsync(StateHasChanged);

    public void Dispose() => Download.OnProgressChanged -= OnProgress;
}
