@inherits LayoutComponentBase

<MudThemeProvider Theme="GetTheme()" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudHidden Breakpoint="Breakpoint.Xs">
        <NavMenu/>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.Xs" Invert>
        <MobileNavBar/>
    </MudHidden>
    <MudMainContent Style="min-height: 100vh">
        <SyncStatusBar />
        <BoltonCupErrorBoundary>
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
                @Body
            </MudContainer>
        </BoltonCupErrorBoundary>
    </MudMainContent>
</MudLayout>
