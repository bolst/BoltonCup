# Database
CONNECTION_STRING=User Id=bcadmin;Password=<password>;Server=postgres;Port=5432;Database=boltoncup

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# R2_BASE_URL=https://assets.boltoncup.ca/

# Resend (HTTP API)
RESEND_ENABLED=false
RESEND_API_KEY=
# RESEND_SENDER_NAME=Bolton Cup
# RESEND_SENDER_EMAIL=notifications@boltoncup.ca

# Twilio (SMS)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE_NUMBER=+15555550123

# Trade notifications
# Set to false to stop sending trade lifecycle emails (SMS is unaffected). Defaults to true.
# TRADE_NOTIFICATION_EMAILS_ENABLED=true

# Optional
# ADMIN_EMAIL=
# SENTRY_DSN=
# OpenTelemetry (OTLP) export from the WebAPI; nothing is exported unless the endpoint is set
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Collector auth headers (e.g. Authorization=Basic xyz); kept out of OTEL_* so they never reach Sentry
# OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1.0
# WEBAPI_TAG=latest
# WEBAPI_PORT=8080

# Only for docker-compose.postgres.yml
POSTGRES_PASSWORD=<password>
# POSTGRES_USER=bcadmin
# POSTGRES_DB=boltoncup
# POSTGRES_PORT=5432

# Spotify
# SPOTIFY_CLIENT_ID=<client id>
# SPOTIFY_CLIENT_SECRET=<client secret>